<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem CBT Online - Latihan Matematika Kelas 4</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        /* Print Calibration */
        @media print {
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            body {
                background: white !important;
                color: black !important;
                padding: 0 !important;
            }
            .print-card {
                border: 1px solid #cbd5e1 !important;
                box-shadow: none !important;
                page-break-inside: avoid;
            }
            @page {
                size: A4;
                margin: 15mm;
            }
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- TOP HEADER -->
    <header class="bg-indigo-700 text-white shadow-lg no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-white text-indigo-700 p-2 rounded-lg font-bold text-xl shadow-inner">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold leading-tight">CBT Pintar Matematika</h1>
                    <p class="text-xs text-indigo-200">SD Negeri 1 Nusantara - Kelas 4 SD</p>
                </div>
            </div>
            <div id="userInfoHeader" class="hidden flex items-center space-x-4">
                <div class="text-right">
                    <p id="headerUserName" class="text-sm font-semibold">Nama Siswa</p>
                    <span id="headerUserRole" class="inline-block text-[10px] bg-indigo-500 text-white px-2 py-0.5 rounded-full uppercase tracking-wider">Siswa</span>
                </div>
                <button onclick="logout()" class="bg-indigo-800 hover:bg-indigo-900 text-xs px-3 py-2 rounded-lg transition border border-indigo-500 flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- VIEW 1: LOGIN SCREEN -->
        <section id="loginView" class="max-w-md mx-auto my-12 bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
                    <i class="fa-solid fa-user-lock"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">Masuk Portal CBT</h2>
                <p class="text-xs text-slate-500 mt-1">Masukkan data akses ujian atau manajemen guru</p>
            </div>

            <!-- TAB ROLES -->
            <div class="flex bg-slate-100 p-1 rounded-xl mb-6 text-sm font-medium">
                <button id="tabStudent" onclick="switchLoginTab('student')" class="flex-1 py-2 rounded-lg text-center bg-white shadow-sm text-indigo-600 font-semibold transition">
                    <i class="fa-solid fa-user-graduate mr-1"></i> Siswa
                </button>
                <button id="tabTeacher" onclick="switchLoginTab('teacher')" class="flex-1 py-2 rounded-lg text-center text-slate-500 hover:text-slate-800 transition">
                    <i class="fa-solid fa-chalkboard-user mr-1"></i> Guru / Admin
                </button>
            </div>

            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1" id="loginLabelName">Nama Lengkap Siswa</label>
                    <input type="text" id="loginName" required placeholder="Contoh: Budi Santoso" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1" id="loginLabelId">NISN / Nomor Ujian</label>
                    <input type="text" id="loginId" required placeholder="Masukkan nomor registrasi" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                </div>

                <div id="passwordContainer" class="hidden">
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Kata Sandi (Khusus Guru)</label>
                    <input type="password" id="loginPassword" placeholder="Masukkan password" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                    <p class="text-[11px] text-slate-400 mt-1">* Password default guru: <span class="font-mono text-indigo-600">admin123</span></p>
                </div>

                <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 transition duration-200 flex items-center justify-center gap-2">
                    <span>Masuk Ujian</span> <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </form>

            <div class="mt-6 pt-4 border-t border-slate-100 text-center text-xs text-slate-400">
                Materi: Pecahan, KPK, FPB, & Kelipatan (Kelas 4 SD)
            </div>
        </section>

        <!-- VIEW 2: EXAM DASHBOARD (EXAM MODE) -->
        <section id="examView" class="hidden space-y-6">
            <!-- TIMER & HEADER STRIP -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-4 sticky top-4 z-10 no-print">
                <div class="flex items-center space-x-4">
                    <div class="bg-indigo-50 text-indigo-700 p-3 rounded-lg">
                        <i class="fa-solid fa-book-open text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-base">Penilaian Harian Matematika</h3>
                        <p class="text-xs text-slate-500">Pecahan, KPK, FPB, & Kelipatan</p>
                    </div>
                </div>

                <!-- TIMER BOX -->
                <div class="flex items-center bg-amber-50 border border-amber-200 text-amber-800 px-4 py-2 rounded-xl">
                    <i class="fa-regular fa-clock text-xl mr-3 animate-pulse"></i>
                    <div>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-amber-600">Sisa Waktu</span>
                        <span id="timerDisplay" class="font-mono text-xl font-bold">30:00</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- MAIN QUESTION CONTAINER -->
                <div class="lg:col-span-3 space-y-6">
                    <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200">
                        <div class="flex justify-between items-center mb-6 pb-4 border-b border-slate-100">
                            <span class="bg-indigo-100 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full">
                                Soal No. <span id="currentQuestionNum">1</span> dari <span id="totalQuestionsNum">10</span>
                            </span>
                            <span class="text-xs text-slate-400">Literasi & Matematika</span>
                        </div>

                        <!-- QUESTION CONTENT -->
                        <div id="questionBody" class="space-y-4">
                            <!-- Image Container -->
                            <div id="questionImageWrapper" class="hidden mb-4">
                                <img id="questionImage" src="" alt="Lampiran Soal" class="max-h-64 rounded-xl border border-slate-200 object-contain mx-auto shadow-sm">
                            </div>
                            
                            <!-- Text -->
                            <div id="questionText" class="text-slate-800 text-base sm:text-lg leading-relaxed font-medium">
                                <!-- Question text injected via JS -->
                            </div>
                        </div>

                        <!-- OPTIONS CONTAINER -->
                        <div id="optionsContainer" class="mt-8 space-y-3">
                            <!-- Radio Options Injected via JS -->
                        </div>

                        <!-- FOOTER CONTROLS -->
                        <div class="mt-8 pt-6 border-t border-slate-100 flex justify-between items-center">
                            <button id="prevBtn" onclick="navigateQuestion(-1)" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-medium text-sm transition flex items-center gap-2">
                                <i class="fa-solid fa-arrow-left"></i> Sebelumnya
                            </button>
                            <button id="nextBtn" onclick="navigateQuestion(1)" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium text-sm transition flex items-center gap-2">
                                Selanjutnya <i class="fa-solid fa-arrow-right"></i>
                            </button>
                            <button id="finishExamBtn" onclick="confirmFinishExam()" class="hidden px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-medium text-sm shadow-md shadow-emerald-100 transition flex items-center gap-2">
                                <i class="fa-solid fa-check-circle"></i> Selesaikan Ujian
                            </button>
                        </div>
                    </div>
                </div>

                <!-- NAVIGATION GRID SIDEBAR -->
                <div class="lg:col-span-1">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 sticky top-24">
                        <h4 class="font-bold text-slate-800 text-sm mb-3 flex items-center justify-between">
                            <span>Navigasi Soal</span>
                            <i class="fa-solid fa-grip text-slate-400"></i>
                        </h4>
                        <p class="text-xs text-slate-500 mb-4">Klik nomor untuk melompati soal.</p>
                        
                        <div id="questionGrid" class="grid grid-cols-5 gap-2">
                            <!-- Nav buttons injected via JS -->
                        </div>

                        <div class="mt-6 pt-4 border-t border-slate-100 space-y-2 text-xs">
                            <div class="flex items-center space-x-2 text-slate-600">
                                <span class="w-3 h-3 bg-indigo-600 rounded-md"></span>
                                <span>Sedang Dibuka</span>
                            </div>
                            <div class="flex items-center space-x-2 text-slate-600">
                                <span class="w-3 h-3 bg-emerald-500 rounded-md"></span>
                                <span>Sudah Dijawab</span>
                            </div>
                            <div class="flex items-center space-x-2 text-slate-600">
                                <span class="w-3 h-3 bg-slate-200 rounded-md"></span>
                                <span>Belum Dijawab</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- VIEW 3: TEACHER / ADMIN PANEL (EDIT SOAL & WAKTU) -->
        <section id="teacherView" class="hidden space-y-6">
            <div class="flex flex-wrap justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-slate-200 gap-4">
                <div>
                    <h2 class="text-xl font-bold text-slate-800">Panel Manajemen Guru</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Atur durasi ujian, kelola bank soal, dan lampirkan gambar.</p>
                </div>
                <div class="flex items-center space-x-3">
                    <button onclick="addNewQuestionModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-4 py-2.5 rounded-xl font-semibold transition flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i> Tambah Soal Baru
                    </button>
                    <button onclick="resetDefaultQuestions()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2.5 rounded-xl font-semibold transition">
                        <i class="fa-solid fa-rotate-left"></i> Reset Bank Soal
                    </button>
                </div>
            </div>

            <!-- TIME SETTINGS CARD -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 max-w-xl">
                <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-clock text-indigo-600"></i> Pengaturan Waktu Ujian
                </h3>
                <div class="flex items-center space-x-4">
                    <input type="number" id="inputExamDuration" min="1" max="180" value="30" class="w-32 px-3 py-2 border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                    <span class="text-sm text-slate-600">Menit</span>
                    <button onclick="saveDurationSetting()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-4 py-2.5 rounded-lg font-semibold transition">
                        Simpan Durasi
                    </button>
                </div>
            </div>

            <!-- QUESTIONS LIST MANAGEMENT -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-5 bg-slate-50 border-b border-slate-200 font-bold text-sm text-slate-700">
                    Daftar Soal Aktif (<span id="teacherQuestionCount">0</span> Soal)
                </div>
                <div id="teacherQuestionList" class="divide-y divide-slate-100">
                    <!-- Items rendered dynamically -->
                </div>
            </div>
        </section>

        <!-- VIEW 4: SCORE RESULT & PRINTABLE REPORT -->
        <section id="resultView" class="hidden max-w-3xl mx-auto my-6 space-y-6">
            <!-- CARD UTAMA SKOR (NO PRINT HEADING) -->
            <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-200 text-center relative overflow-hidden print-card">
                <div class="no-print">
                    <div id="resultBadge" class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-bold">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-800">Hasil Penilaian Ujian</h2>
                    <p class="text-xs text-slate-500 mt-1">Ujian Matematika SD Kelas 4 - Pecahan, KPK, & FPB</p>
                </div>

                <!-- COKPT CETAK / HEADER RAPOR PRINT ONLY -->
                <div class="hidden print-only text-left mb-6 pb-4 border-b-2 border-slate-800">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-xl font-bold text-black uppercase">SD NEGERI 1 NUSANTARA</h2>
                            <p class="text-xs text-slate-700">Jl. Pendidikan No. 45, Kota Edukasi | Telp: (021) 555-0199</p>
                            <p class="text-xs font-semibold text-slate-800 mt-1">LEMBAR HASIL UJIAN COMPUTED BASED TEST (CBT)</p>
                        </div>
                        <div class="text-right text-xs">
                            <p>Tanggal Cetak: <span id="printDate"></span></p>
                        </div>
                    </div>
                </div>

                <!-- STUDENT INFO TABLE -->
                <div class="bg-slate-50 p-4 rounded-xl text-left my-6 grid grid-cols-2 gap-4 border border-slate-200 text-xs sm:text-sm">
                    <div>
                        <span class="text-slate-400 block text-[10px] uppercase font-bold">Nama Siswa</span>
                        <span id="resStudentName" class="font-bold text-slate-800 text-base">Nama User</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block text-[10px] uppercase font-bold">NISN / ID</span>
                        <span id="resStudentId" class="font-mono font-bold text-slate-800 text-base">123456</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block text-[10px] uppercase font-bold">Waktu Penyelesaian</span>
                        <span id="resTimeSpent" class="font-medium text-slate-700">00:00</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block text-[10px] uppercase font-bold">StatusKelulusan</span>
                        <span id="resStatus" class="font-bold text-emerald-600">LULUS</span>
                    </div>
                </div>

                <!-- SCORE DISPLAY -->
                <div class="py-6 border-y border-slate-100 flex justify-around items-center my-6">
                    <div class="text-center">
                        <span class="text-slate-400 text-xs uppercase font-bold block">Skor Akhir</span>
                        <span id="resFinalScore" class="text-5xl font-extrabold text-indigo-600">0</span>
                        <span class="text-xs text-slate-400 block mt-1">Skala 100</span>
                    </div>
                    <div class="h-12 w-px bg-slate-200"></div>
                    <div class="text-center">
                        <span class="text-slate-400 text-xs uppercase font-bold block">Jawaban Benar</span>
                        <span id="resCorrectCount" class="text-3xl font-bold text-emerald-600">0</span>
                        <span class="text-xs text-slate-400 block mt-1">dari <span class="resTotalCount">10</span> Soal</span>
                    </div>
                </div>

                <!-- DETAIL JAWABAN PER SOAL -->
                <div class="text-left mt-8">
                    <h3 class="font-bold text-slate-800 text-sm mb-3">Rincian Jawaban Soal:</h3>
                    <div id="resDetailsList" class="space-y-3">
                        <!-- List Generated by JS -->
                    </div>
                </div>

                <!-- TANDA TANGAN (PRINT ONLY) -->
                <div class="hidden print-only mt-12 pt-8 grid grid-cols-2 gap-8 text-center text-xs">
                    <div>
                        <p class="mb-16">Mengetahui,<br>Orang Tua / Wali Siswa</p>
                        <p class="font-bold underline">( ..................................... )</p>
                    </div>
                    <div>
                        <p class="mb-16">Guru Mata Pelajaran,</p>
                        <p class="font-bold underline">( Wali Kelas 4 )</p>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap gap-3 justify-center no-print">
                    <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl text-sm font-semibold shadow-md shadow-indigo-200 transition flex items-center gap-2">
                        <i class="fa-solid fa-print"></i> Cetak Hasil / Save PDF
                    </button>
                    <button onclick="logout()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2.5 rounded-xl text-sm font-semibold transition">
                        Selesai & Keluar
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-400 no-print">
        &copy; 2026 CBT Pintar SD - Sistem Engine Ujian Online Matematika Literasi.
    </footer>

    <!-- MODAL: EDIT / TAMBAH SOAL -->
    <div id="questionModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
            <div class="p-5 bg-indigo-700 text-white flex justify-between items-center">
                <h3 id="modalTitle" class="font-bold text-base">Edit Soal</h3>
                <button onclick="closeModal()" class="text-white/80 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            
            <form id="questionForm" onsubmit="saveQuestion(event)" class="p-6 overflow-y-auto space-y-4 custom-scrollbar">
                <input type="hidden" id="editQuestionIndex">

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Teks Soal / Narasi Literasi</label>
                    <textarea id="modalText" rows="4" required class="w-full p-3 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Tuliskan cerita/soal literasi matematika di sini..."></textarea>
                </div>

                <!-- LAMPIRKAN GAMBAR -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Lampiran Gambar (Opsional)</label>
                    <div class="flex items-center space-x-3">
                        <input type="file" id="modalImageInput" accept="image/*" onchange="handleImageUpload(event)" class="text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                        <button type="button" onclick="clearModalImage()" class="text-xs text-rose-600 hover:underline">Hapus Gambar</button>
                    </div>
                    <input type="hidden" id="modalImageData">
                    <!-- Preview Image -->
                    <div id="modalImagePreviewContainer" class="mt-2 hidden">
                        <img id="modalImagePreview" src="" alt="Preview" class="h-32 rounded-lg border border-slate-200 object-contain">
                    </div>
                </div>

                <!-- OPTION INPUTS -->
                <div class="space-y-3 pt-2">
                    <label class="block text-xs font-bold text-slate-700 uppercase">Pilihan Jawaban & Kunci</label>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <span class="text-xs font-semibold text-slate-500">Pilihan A</span>
                            <input type="text" id="modalOpt0" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm mt-1">
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-500">Pilihan B</span>
                            <input type="text" id="modalOpt1" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm mt-1">
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-500">Pilihan C</span>
                            <input type="text" id="modalOpt2" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm mt-1">
                        </div>
                        <div>
                            <span class="text-xs font-semibold text-slate-500">Pilihan D</span>
                            <input type="text" id="modalOpt3" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm mt-1">
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Kunci Jawaban Benar</label>
                    <select id="modalCorrectIndex" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white font-semibold text-indigo-700">
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                </div>

                <div class="pt-4 border-t border-slate-100 flex justify-end space-x-3">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 bg-slate-100 text-slate-600 text-xs font-semibold rounded-lg hover:bg-slate-200">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-indigo-600 text-white text-xs font-semibold rounded-lg hover:bg-indigo-700">Simpan Soal</button>
                </div>
            </form>
        </div>
    </div>

    <!-- APPLICATION SCRIPT LOGIC -->
    <script>
        // -----------------------------------------------------------------
        // DEFAULT BANK SOAL MATEMATIKA KELAS 4 (PECAHAN, KPK, FPB, KELIPATAN)
        // -----------------------------------------------------------------
        const DEFAULT_QUESTIONS = [
            {
                text: "Ibu membeli sebuah kue martabak besar yang dipotong menjadi 8 bagian sama besar untuk acara keluarga. Siti memakan 3 bagian dari martabak tersebut. Berapakah nilai pecahan dari martabak yang dimakan oleh Siti?",
                image: "",
                options: ["1/8 bagian", "3/8 bagian", "5/8 bagian", "8/3 bagian"],
                correct: 1
            },
            {
                text: "Di toko kue Pak Ahmad, roti tawar dipotong menjadi 10 bagian sama rata. Lani membeli 1 loyang, lalu memberikan 4 bagian kepada Dayu dan 3 bagian kepada Udin. Berapa bagian sisa kue tawar milik Lani sekarang?",
                image: "",
                options: ["3/10 bagian", "4/10 bagian", "7/10 bagian", "10/3 bagian"],
                correct: 0
            },
            {
                text: "Beni memiliki dua helai pita untuk merangkai kerajinan tangan. Pita warna merah panjangnya 3/5 meter dan pita warna biru panjangnya 1/5 meter. Berapakah jumlah total panjang kedua pita milik Beni?",
                image: "",
                options: ["2/5 meter", "3/10 meter", "4/5 meter", "4/10 meter"],
                correct: 2
            },
            {
                text: "Perhatikan pecahan berikut: 2/7, 6/7, 1/7, dan 4/7. Jika Ibu meminta adik mengurutkan pecahan tersebut dari nilai yang TERKECIL hingga terbesar, urutan yang benar adalah...",
                image: "",
                options: [
                    "6/7, 4/7, 2/7, 1/7",
                    "1/7, 2/7, 4/7, 6/7",
                    "1/7, 4/7, 2/7, 6/7",
                    "2/7, 1/7, 4/7, 6/7"
                ],
                correct: 1
            },
            {
                text: "Beni dan Edo hobi berenang di kolam umum. Beni pergi latihan renang setiap 4 hari sekali, sedangkan Edo pergi setiap 6 hari sekali. Jika hari ini mereka tidak sengaja bertemu di kolam renang, setelah berapa harikah mereka akan berenang bersama-sama lagi?",
                image: "",
                options: ["10 hari", "12 hari", "18 hari", "24 hari"],
                correct: 1
            },
            {
                text: "Ibu guru ingin membuat paket bingkisan hadiah untuk murid berprestasi. Ibu memiliki 24 buah buku tulis dan 36 buah pensil. Jika setiap bingkisan harus berisi buku dan pensil dengan jumlah yang sama rata tanpa ada sisa, berapa jumlah bingkisan TERBANYAK yang dapat dibuat Ibu?",
                image: "",
                options: ["6 paket", "8 paket", "12 paket", "24 paket"],
                correct: 2
            },
            {
                text: "Pak Rudi memasang dua buah lampu hias taman. Lampu berwarna Merah menyala setiap 3 detik sekali, dan lampu berwarna Hijau menyala setiap 5 detik sekali. Jika kedua lampu pertama kali menyala bersamaan pada detik ke-0, pada detik ke berapakah lampu tersebut menyala bersamaan kembali?",
                image: "",
                options: ["Detik ke-8", "Detik ke-12", "Detik ke-15", "Detik ke-30"],
                correct: 2
            },
            {
                text: "Petugas perpustakaan menata buku cerita di rak. Buku dongeng ditumpuk dalam kelipatan 8, sedangkan buku ensiklopedia ditumpuk dalam kelipatan 12. Tentukan 4 kelipatan persekutuan pertama dari bilangan 4 dan 6!",
                image: "",
                options: ["4, 8, 12, 16", "6, 12, 18, 24", "12, 24, 36, 48", "24, 48, 72, 96"],
                correct: 2
            },
            {
                text: "Siti mempunyai pita hias sepanjang 7/8 meter. Ia menggunakannya untuk menghias kado ulang tahun sahabatnya sepanjang 3/8 meter. Berapakah sisa panjang pita hias milik Siti sekarang?",
                image: "",
                options: ["4/8 meter", "3/8 meter", "10/8 meter", "4/0 meter"],
                correct: 0
            },
            {
                text: "Sebuah toko kelontong menerima pasokan telur setiap 6 hari sekali dan pasokan minyak goreng setiap 8 hari sekali. Pada hari ke berapakah toko tersebut akan menerima pasokan telur dan minyak goreng secara bersamaan untuk pertama kalinya?",
                image: "",
                options: ["Hari ke-14", "Hari ke-16", "Hari ke-24", "Hari ke-48"],
                correct: 2
            }
        ];

        // -----------------------------------------------------------------
        // GLOBAL STATE
        // -----------------------------------------------------------------
        let questions = [];
        let currentUser = null; // { name, id, role: 'student'|'teacher' }
        let userAnswers = []; // Array of selected option indexes
        let currentQuestionIdx = 0;
        let examTimerInterval = null;
        let examTimeLeft = 30 * 60; // default 30 mins in seconds
        let examDurationMinutes = 30;

        // -----------------------------------------------------------------
        // INITIALIZATION
        // -----------------------------------------------------------------
        window.addEventListener('DOMContentLoaded', () => {
            loadQuestionsFromStorage();
            loadDurationFromStorage();
            updatePrintDate();
        });

        function loadQuestionsFromStorage() {
            const stored = localStorage.getItem('cbt_questions');
            if (stored) {
                try {
                    questions = JSON.parse(stored);
                } catch(e) {
                    questions = [...DEFAULT_QUESTIONS];
                }
            } else {
                questions = [...DEFAULT_QUESTIONS];
                saveQuestionsToStorage();
            }
        }

        function saveQuestionsToStorage() {
            localStorage.setItem('cbt_questions', JSON.stringify(questions));
        }

        function loadDurationFromStorage() {
            const storedDur = localStorage.getItem('cbt_duration');
            if (storedDur) {
                examDurationMinutes = parseInt(storedDur);
                document.getElementById('inputExamDuration').value = examDurationMinutes;
            }
        }

        function updatePrintDate() {
            const now = new Date();
            const options = { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
            document.getElementById('printDate').innerText = now.toLocaleDateString('id-ID', options);
        }

        // -----------------------------------------------------------------
        // LOGIN & NAVIGATION LOGIC
        // -----------------------------------------------------------------
        let currentLoginRole = 'student';

        function switchLoginTab(role) {
            currentLoginRole = role;
            const tabStudent = document.getElementById('tabStudent');
            const tabTeacher = document.getElementById('tabTeacher');
            const passContainer = document.getElementById('passwordContainer');
            const labelName = document.getElementById('loginLabelName');
            const labelId = document.getElementById('loginLabelId');

            if (role === 'student') {
                tabStudent.className = "flex-1 py-2 rounded-lg text-center bg-white shadow-sm text-indigo-600 font-semibold transition";
                tabTeacher.className = "flex-1 py-2 rounded-lg text-center text-slate-500 hover:text-slate-800 transition";
                passContainer.classList.add('hidden');
                labelName.innerText = "Nama Lengkap Siswa";
                labelId.innerText = "NISN / Nomor Ujian";
            } else {
                tabTeacher.className = "flex-1 py-2 rounded-lg text-center bg-white shadow-sm text-indigo-600 font-semibold transition";
                tabStudent.className = "flex-1 py-2 rounded-lg text-center text-slate-500 hover:text-slate-800 transition";
                passContainer.classList.remove('hidden');
                labelName.innerText = "Nama Lengkap Guru";
                labelId.innerText = "NIP / ID Pendidik";
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const name = document.getElementById('loginName').value.trim();
            const id = document.getElementById('loginId').value.trim();
            const password = document.getElementById('loginPassword').value;

            if (currentLoginRole === 'teacher') {
                if (password !== 'admin123') {
                    alert('Password Guru Salah! (Default: admin123)');
                    return;
                }
                currentUser = { name, id, role: 'teacher' };
                showTeacherPanel();
            } else {
                currentUser = { name, id, role: 'student' };
                startExam();
            }

            // Update Header
            document.getElementById('userInfoHeader').classList.remove('hidden');
            document.getElementById('headerUserName').innerText = currentUser.name;
            document.getElementById('headerUserRole').innerText = currentUser.role === 'teacher' ? 'Guru' : 'Siswa';

            // Hide Login
            document.getElementById('loginView').classList.add('hidden');
        }

        function logout() {
            clearInterval(examTimerInterval);
            currentUser = null;
            userAnswers = [];
            currentQuestionIdx = 0;

            document.getElementById('loginView').classList.remove('hidden');
            document.getElementById('examView').classList.add('hidden');
            document.getElementById('teacherView').classList.add('hidden');
            document.getElementById('resultView').classList.add('hidden');
            document.getElementById('userInfoHeader').classList.add('hidden');

            document.getElementById('loginForm').reset();
        }

        // -----------------------------------------------------------------
        // EXAM ENGINE LOGIC
        // -----------------------------------------------------------------
        function startExam() {
            userAnswers = new Array(questions.length).fill(null);
            currentQuestionIdx = 0;
            examTimeLeft = examDurationMinutes * 60;

            document.getElementById('examView').classList.remove('hidden');
            document.getElementById('totalQuestionsNum').innerText = questions.length;

            renderQuestion();
            renderQuestionGrid();
            startTimer();
        }

        function startTimer() {
            clearInterval(examTimerInterval);
            updateTimerDisplay();

            examTimerInterval = setInterval(() => {
                examTimeLeft--;
                updateTimerDisplay();

                if (examTimeLeft <= 0) {
                    clearInterval(examTimerInterval);
                    alert("Waktu ujian telah habis! Jawaban Anda akan otomatis dikumpulkan.");
                    finishExam();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const minutes = Math.floor(examTimeLeft / 60);
            const seconds = examTimeLeft % 60;
            document.getElementById('timerDisplay').innerText = 
                `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }

        function renderQuestion() {
            const q = questions[currentQuestionIdx];
            document.getElementById('currentQuestionNum').innerText = currentQuestionIdx + 1;
            
            // Text
            document.getElementById('questionText').innerText = q.text;

            // Image attachment
            const imgWrapper = document.getElementById('questionImageWrapper');
            const imgEl = document.getElementById('questionImage');
            if (q.image && q.image.trim() !== '') {
                imgEl.src = q.image;
                imgWrapper.classList.remove('hidden');
            } else {
                imgWrapper.classList.add('hidden');
            }

            // Options
            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = '';

            const optionLabels = ['A', 'B', 'C', 'D'];
            q.options.forEach((optText, optIdx) => {
                const isSelected = userAnswers[currentQuestionIdx] === optIdx;
                
                const btn = document.createElement('label');
                btn.className = `flex items-center p-4 rounded-xl border-2 cursor-pointer transition ${
                    isSelected 
                        ? 'border-indigo-600 bg-indigo-50/50 text-indigo-900 font-medium' 
                        : 'border-slate-200 hover:border-slate-300 bg-white text-slate-700'
                }`;

                btn.innerHTML = `
                    <input type="radio" name="questionOption" value="${optIdx}" ${isSelected ? 'checked' : ''} 
                        onchange="selectAnswer(${optIdx})" class="hidden">
                    <span class="w-8 h-8 rounded-lg text-xs flex items-center justify-center font-bold mr-3 ${
                        isSelected ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600'
                    }">${optionLabels[optIdx]}</span>
                    <span class="text-sm flex-grow">${optText}</span>
                `;
                optionsContainer.appendChild(btn);
            });

            // Navigation Buttons State
            document.getElementById('prevBtn').disabled = currentQuestionIdx === 0;
            document.getElementById('prevBtn').style.opacity = currentQuestionIdx === 0 ? '0.5' : '1';

            if (currentQuestionIdx === questions.length - 1) {
                document.getElementById('nextBtn').classList.add('hidden');
                document.getElementById('finishExamBtn').classList.remove('hidden');
            } else {
                document.getElementById('nextBtn').classList.remove('hidden');
                document.getElementById('finishExamBtn').classList.add('hidden');
            }

            renderQuestionGrid();
        }

        function selectAnswer(optIdx) {
            userAnswers[currentQuestionIdx] = optIdx;
            renderQuestion();
        }

        function navigateQuestion(direction) {
            const targetIdx = currentQuestionIdx + direction;
            if (targetIdx >= 0 && targetIdx < questions.length) {
                currentQuestionIdx = targetIdx;
                renderQuestion();
            }
        }

        function jumpToQuestion(idx) {
            currentQuestionIdx = idx;
            renderQuestion();
        }

        function renderQuestionGrid() {
            const grid = document.getElementById('questionGrid');
            grid.innerHTML = '';

            questions.forEach((_, idx) => {
                const isCurrent = idx === currentQuestionIdx;
                const isAnswered = userAnswers[idx] !== null;

                let stateClass = "bg-slate-100 text-slate-600 hover:bg-slate-200";
                if (isCurrent) {
                    stateClass = "bg-indigo-600 text-white ring-2 ring-indigo-300 font-bold";
                } else if (isAnswered) {
                    stateClass = "bg-emerald-500 text-white font-medium";
                }

                const btn = document.createElement('button');
                btn.className = `h-10 rounded-lg text-xs transition flex items-center justify-center ${stateClass}`;
                btn.innerText = idx + 1;
                btn.onclick = () => jumpToQuestion(idx);
                grid.appendChild(btn);
            });
        }

        function confirmFinishExam() {
            const unanswered = userAnswers.filter(a => a === null).length;
            let msg = "Apakah Anda yakin ingin mengumpulkan jawaban?";
            if (unanswered > 0) {
                msg = `Masih ada ${unanswered} soal yang belum dijawab! Yakin ingin menyelesaikannya sekarang?`;
            }

            if (confirm(msg)) {
                finishExam();
            }
        }

        function finishExam() {
            clearInterval(examTimerInterval);

            // Calculate Score
            let correctCount = 0;
            questions.forEach((q, idx) => {
                if (userAnswers[idx] === q.correct) {
                    correctCount++;
                }
            });

            const total = questions.length;
            const finalScore = Math.round((correctCount / total) * 100);
            const timeSpentSec = (examDurationMinutes * 60) - examTimeLeft;
            const spentMins = Math.floor(timeSpentSec / 60);
            const spentSecs = timeSpentSec % 60;

            // Render Result View
            document.getElementById('examView').classList.add('hidden');
            document.getElementById('resultView').classList.remove('hidden');

            document.getElementById('resStudentName').innerText = currentUser.name;
            document.getElementById('resStudentId').innerText = currentUser.id;
            document.getElementById('resTimeSpent').innerText = `${spentMins} Menit ${spentSecs} Detik`;
            document.getElementById('resFinalScore').innerText = finalScore;
            document.getElementById('resCorrectCount').innerText = correctCount;
            document.querySelectorAll('.resTotalCount').forEach(el => el.innerText = total);

            const statusEl = document.getElementById('resStatus');
            if (finalScore >= 70) {
                statusEl.innerText = "TUNTAS (LULUS)";
                statusEl.className = "font-bold text-emerald-600";
            } else {
                statusEl.innerText = "REMIDIAL";
                statusEl.className = "font-bold text-rose-600";
            }

            // Render Details
            const detailsList = document.getElementById('resDetailsList');
            detailsList.innerHTML = '';

            const optionLabels = ['A', 'B', 'C', 'D'];

            questions.forEach((q, idx) => {
                const userAns = userAnswers[idx];
                const isCorrect = userAns === q.correct;

                const card = document.createElement('div');
                card.className = `p-4 rounded-xl border text-xs sm:text-sm space-y-2 ${
                    isCorrect ? 'bg-emerald-50/60 border-emerald-200' : 'bg-rose-50/60 border-rose-200'
                }`;

                card.innerHTML = `
                    <div class="flex justify-between items-start font-bold">
                        <span>Soal ${idx + 1}: ${q.text.substring(0, 80)}...</span>
                        <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold ${
                            isCorrect ? 'bg-emerald-200 text-emerald-800' : 'bg-rose-200 text-rose-800'
                        }">${isCorrect ? 'Benar' : 'Salah'}</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-1 text-slate-600">
                        <div>Jawaban Anda: <span class="font-semibold ${isCorrect ? 'text-emerald-700' : 'text-rose-700'}">
                            ${userAns !== null ? optionLabels[userAns] + '. ' + q.options[userAns] : 'Tidak Dijawab'}
                        </span></div>
                        <div>Kunci Jawaban: <span class="font-semibold text-indigo-700">
                            ${optionLabels[q.correct]}. ${q.options[q.correct]}
                        </span></div>
                    </div>
                `;
                detailsList.appendChild(card);
            });
        }

        // -----------------------------------------------------------------
        // TEACHER PANEL LOGIC
        // -----------------------------------------------------------------
        function showTeacherPanel() {
            document.getElementById('teacherView').classList.remove('hidden');
            renderTeacherQuestionList();
        }

        function saveDurationSetting() {
            const val = parseInt(document.getElementById('inputExamDuration').value);
            if (val && val > 0) {
                examDurationMinutes = val;
                localStorage.setItem('cbt_duration', val);
                alert(`Durasi ujian berhasil diperbarui menjadi ${val} menit!`);
            }
        }

        function renderTeacherQuestionList() {
            const container = document.getElementById('teacherQuestionList');
            document.getElementById('teacherQuestionCount').innerText = questions.length;
            container.innerHTML = '';

            const optionLabels = ['A', 'B', 'C', 'D'];

            questions.forEach((q, idx) => {
                const item = document.createElement('div');
                item.className = "p-5 flex flex-wrap sm:flex-nowrap justify-between items-start gap-4 hover:bg-slate-50 transition";
                
                item.innerHTML = `
                    <div class="space-y-2 flex-grow">
                        <div class="flex items-center space-x-2">
                            <span class="bg-indigo-100 text-indigo-700 text-xs font-bold px-2.5 py-0.5 rounded">Soal ${idx + 1}</span>
                            ${q.image ? '<span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded"><i class="fa-solid fa-image"></i> Ada Gambar</span>' : ''}
                        </div>
                        <p class="text-sm font-medium text-slate-800">${q.text}</p>
                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-500 pt-1">
                            ${q.options.map((opt, oIdx) => `
                                <div class="${oIdx === q.correct ? 'text-emerald-700 font-bold' : ''}">
                                    ${optionLabels[oIdx]}. ${opt} ${oIdx === q.correct ? '✓' : ''}
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 shrink-0">
                        <button onclick="editQuestionModal(${idx})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition text-xs font-semibold">
                            <i class="fa-solid fa-pen-to-square"></i> Edit
                        </button>
                        <button onclick="deleteQuestion(${idx})" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg transition text-xs font-semibold">
                            <i class="fa-solid fa-trash"></i> Hapus
                        </button>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function resetDefaultQuestions() {
            if (confirm("Kembalikan bank soal ke setelan awal pabrik (10 soal default)?")) {
                questions = [...DEFAULT_QUESTIONS];
                saveQuestionsToStorage();
                renderTeacherQuestionList();
            }
        }

        function deleteQuestion(idx) {
            if (confirm(`Hapus soal nomor ${idx + 1}?`)) {
                questions.splice(idx, 1);
                saveQuestionsToStorage();
                renderTeacherQuestionList();
            }
        }

        // -----------------------------------------------------------------
        // MODAL MANAGEMENT (EDIT / ADD SOAL & GAMBAR)
        // -----------------------------------------------------------------
        function addNewQuestionModal() {
            document.getElementById('modalTitle').innerText = "Tambah Soal Baru";
            document.getElementById('editQuestionIndex').value = "-1";
            document.getElementById('questionForm').reset();
            clearModalImage();
            document.getElementById('questionModal').classList.remove('hidden');
        }

        function editQuestionModal(idx) {
            const q = questions[idx];
            document.getElementById('modalTitle').innerText = `Edit Soal #${idx + 1}`;
            document.getElementById('editQuestionIndex').value = idx;
            document.getElementById('modalText').value = q.text;
            
            document.getElementById('modalOpt0').value = q.options[0];
            document.getElementById('modalOpt1').value = q.options[1];
            document.getElementById('modalOpt2').value = q.options[2];
            document.getElementById('modalOpt3').value = q.options[3];
            
            document.getElementById('modalCorrectIndex').value = q.correct;

            // Handle Image preview
            if (q.image) {
                document.getElementById('modalImageData').value = q.image;
                document.getElementById('modalImagePreview').src = q.image;
                document.getElementById('modalImagePreviewContainer').classList.remove('hidden');
            } else {
                clearModalImage();
            }

            document.getElementById('questionModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('questionModal').classList.add('hidden');
        }

        function handleImageUpload(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const base64 = evt.target.result;
                    document.getElementById('modalImageData').value = base64;
                    document.getElementById('modalImagePreview').src = base64;
                    document.getElementById('modalImagePreviewContainer').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function clearModalImage() {
            document.getElementById('modalImageInput').value = "";
            document.getElementById('modalImageData').value = "";
            document.getElementById('modalImagePreview').src = "";
            document.getElementById('modalImagePreviewContainer').classList.add('hidden');
        }

        function saveQuestion(e) {
            e.preventDefault();
            const idx = parseInt(document.getElementById('editQuestionIndex').value);
            
            const qData = {
                text: document.getElementById('modalText').value,
                image: document.getElementById('modalImageData').value,
                options: [
                    document.getElementById('modalOpt0').value,
                    document.getElementById('modalOpt1').value,
                    document.getElementById('modalOpt2').value,
                    document.getElementById('modalOpt3').value
                ],
                correct: parseInt(document.getElementById('modalCorrectIndex').value)
            };

            if (idx === -1) {
                questions.push(qData);
            } else {
                questions[idx] = qData;
            }

            saveQuestionsToStorage();
            renderTeacherQuestionList();
            closeModal();
        }
    </script>
</body>
</html>
